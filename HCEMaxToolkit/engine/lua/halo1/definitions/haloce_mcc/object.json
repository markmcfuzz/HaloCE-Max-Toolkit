   "max_count_string": "NUMBER_OF_OBJECT_CHANGE_COLORS",
   "element_label": {
    "source": "tool.exe 0x4A0820",
    "label": [
     {
      "when": "{darken by} > 0 && {scale by} > 0",
      "format": "{#|map:letters}(dark:{darken by})(scale:{scale by})"
     },
     {
      "when": "{darken by} > 0",
      "format": "{#|map:letters}(dark:{darken by})"
     },
     {
      "when": "{scale by} > 0",
      "format": "{#|map:letters}(scale:{scale by})"
     },
     {
      "when": "1",
      "format": "{#|map:letters}"
     }
    ],
    "maps": {
     "letters": {
      "names": [
       "A",
       "B",
       "C",
       "D"
      ]
     }
    }
   },
