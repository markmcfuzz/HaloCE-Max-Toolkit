    "source": "tool.exe 0x4A0780",
    "label": [
     {
      "when": "{usage} != \"\"",
      "format": "{#|map:outputs} ({usage})"
     },
     {
      "when": "1",
      "format": "{#|map:outputs}"
     }
    ],
    "maps": {
     "outputs": {
      "names": [
       "A out",
       "B out",
       "C out",
       "D out"
      ]
     }
    }
   },
